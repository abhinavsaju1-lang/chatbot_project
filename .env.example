# ==============================================================================
# MindSense-AI Environment Variables Template
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# Flask Session Security Key
SECRET_KEY=replace_with_a_secure_random_secret_key_32_chars_or_more

# MongoDB Atlas Connection URI (Include credentials and database name)
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mindsense_db?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/mindsense_db
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/mindsense_db?retryWrites=true&w=majority

# Groq Cloud API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Model (Default: llama-3.3-70b-versatile or llama-3.1-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
